{
  "name": "yardi-launchpad",
  "version": "1.0.0",
  "description": "YARDI LaunchPad – 15-Day Pre-Joining Journey Platform",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "init:curriculum": "npm --prefix server run init:curriculum",
    "clean:demo": "npm --prefix server run clean:demo",
    "create:admin": "npm --prefix server run create:admin",
    "test:e2e": "npm --prefix server run test:e2e",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "yardi",
    "launchpad",
    "onboarding",
    "employee-journey",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Yardi Systems",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
